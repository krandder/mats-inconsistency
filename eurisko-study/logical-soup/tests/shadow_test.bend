def pat.chk(xs: List<&2, U32>) -> Bool:
  match xs:
    case Con{k, Con{h, Con{e, t}}}:
      U32.is_eq(S.pat.predict(U32.to_nat(k), h), e) && pat.chk(t)
    case _:
      True{}

def t_pat() -> Bool:
  pat.chk(pat.cases())

# the arbitrageur never loses when it trades: net >= violation, every outcome
def arb.at(+pa: U32, +pb: U32, +pc: U32, +pd: U32, +oa: U32, +ob: U32, +min: U32) -> Bool:
  +x = net(S.arb(pa, pb, pc, pd, oa, ob, U32.and(oa, ob), U32.or(oa, ob)))
  U32.is_ge(x, min) && U32.is_lt(x, 2147483648)

def arb.all(+pa: U32, +pb: U32, +pc: U32, +pd: U32, +min: U32) -> Bool:
  arb.at(pa, pb, pc, pd, 0, 0, min) && arb.at(pa, pb, pc, pd, 0, 1, min) && arb.at(pa, pb, pc, pd, 1, 0, min) && arb.at(pa, pb, pc, pd, 1, 1, min)

def t_arb() -> Bool:
  +coh = U32.is_eq(net(S.arb(32768, 32768, 16384, 49152, 1, 0, 0, 1)), 0) && U32.is_eq(net(S.arb(32768, 32768, 16384, 49152, 1, 1, 1, 1)), 0)
  coh && arb.all(32768, 32768, 49152, 49152, 16384) && arb.all(39322, 19661, 13107, 32768, 6554) && arb.all(40000, 30000, 50000, 20000, 30000)

def sh.zero(s: S.Sh) -> Bool:
  match s:
    case S.Sh{a, b, c, d, e, f}:
      U32.is_eq(net(a), 0) && U32.is_eq(net(b), 0) && U32.is_eq(net(c), 0)

def t_gate() -> Bool:
  sh.zero(S.Sh.gate(False{}, S.Sh.question(0, 1, 1))) && Bool.not(sh.zero(S.Sh.question(0, 1, 1)))

def res(name: String, ok: Bool) -> String:
  match ok:
    case True{}:
      String.join(["ok   ", name], "")
    case False{}:
      String.join(["FAIL ", name], "")

def summary(ok: Bool) -> String:
  match ok:
    case True{}:
      "shadow: PASS (6 tests: pnl, constant 0.5, momentum, pattern-k oracle x525, arbitrageur all outcomes, gating)"
    case False{}:
      "shadow: FAIL"

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(res("pnl", t_pnl()))
    IO.print(res("constant 0.5", t_c50()))
    IO.print(res("momentum", t_mom()))
    IO.print(res("pattern-k oracle", t_pat()))
    IO.print(res("arbitrageur", t_arb()))
    IO.print(res("gating", t_gate()))
    IO.print(summary(t_pnl() && t_c50() && t_mom() && t_pat() && t_arb() && t_gate()))
