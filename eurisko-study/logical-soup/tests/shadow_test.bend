import Base
import ../src/types.bend as T
import ../src/shadow.bend as S
# Shadow trader tests: one-share pnl, pattern-k against a Python oracle
# (periodic streams P = 2..16 at every phase plus 40 random histories),
# the arbitrageur's locked-in profit under every outcome, and gating.

def net(x: S.GL) -> U32:
  match x:
    case S.GL{g, l}:
      U32.sub(U32.from_nat(g), U32.from_nat(l))

def t_pnl() -> Bool:
  U32.is_eq(net(S.pnl(1, 16384, 1)), 49152) && U32.is_eq(net(S.pnl(1, 16384, 0)), U32.sub(0, 16384)) && U32.is_eq(net(S.pnl(2, 16384, 1)), U32.sub(0, 49152)) && U32.is_eq(net(S.pnl(2, 16384, 0)), 16384) && U32.is_eq(net(S.pnl(0, 16384, 1)), 0)

def t_c50() -> Bool:
  U32.is_eq(S.sig.c50(30000), 1) && U32.is_eq(S.sig.c50(40000), 2) && U32.is_eq(S.sig.c50(32768), 0)

def t_mom() -> Bool:
  U32.is_eq(S.sig.mom(5, 100), 1) && U32.is_eq(S.sig.mom(4, 100), 2) && U32.is_eq(S.sig.mom(5, 65536), 0)

